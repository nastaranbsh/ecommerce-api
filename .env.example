# Docker Compose project name.
# Different names create isolated containers, networks, and volumes.
# Examples: commerce-dev | commerce-demo | commerce-prod
COMPOSE_PROJECT_NAME=commerce-dev

# ==========================================
# SERVER
# ==========================================
SPRING_SERVER_PORT=8080

# ==========================================
# DATABASE
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_NAME=commerce
POSTGRES_USERNAME=commerce
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_SSL_MODE=disable

# ==========================================
# DATABASE POOL — PRODUCTION ONLY
# ==========================================
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000

# ==========================================
# REDIS
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2s
REDIS_CONNECT_TIMEOUT=2s

# ==========================================
# SECURITY
# ==========================================
JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900
# JWT_ACCESS_EXPIRATION_MS=900000
# JWT_REFRESH_EXPIRATION_MS=604800000
# JWT_EXPIRATION_MS=3600000

# ==================================================
# Application Environment
# ==================================================
# Deployment identity used for logs and metrics.
# Suggested values: local | development | test | demo | staging | production
APP_DEPLOYMENT_ENVIRONMENT=local

# Spring Boot configuration profile.
# Available project profiles: dev | test | demo | prod | sql-debug
# Multiple Active profiles Example: dev,sql-debug
SPRING_PROFILES_ACTIVE=dev

# ==========================================
# DEVELOPMENT / TEST
# ==========================================
# Development-only admin initialization
# Must never be enabled in production.
DEV_ADMIN_ENABLED=false

# Used only when DEV_ADMIN_ENABLED=true
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=replace-me

FAKE_PAYMENT_OUTCOME=SUCCESS

# ==========================================
# CORS — Demo / Production
# ==========================================
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
